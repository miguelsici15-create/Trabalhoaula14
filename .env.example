NOME_DO_SISTEMA=


# Porta em que a aplicação será executada
PORT=5000

# Ambiente: development ou production
NODE_ENV=development

# Endereço do servidor de banco de dados
DB_HOST=127.0.0.1

# Porta do banco de dados PostgreSQL
DB_PORT=5432

# Chave obrigatória da API de pagamentos
PAYMENT_API_KEY=coloque_sua_chave_aqui

# Segredo obrigatório para assinar tokens JWT
JWT_SECRET=gere_um_segredo_forte_aqui
